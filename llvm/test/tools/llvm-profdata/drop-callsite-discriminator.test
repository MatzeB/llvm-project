
; facebook T156867704
RUN: llvm-profdata merge --sample --text %S/Inputs/inline-samples.afdo -output=%t0.proftext
RUN: FileCheck --input-file=%t0.proftext %s  -check-prefixes=DISC
RUN: llvm-profdata merge --sample --text %S/Inputs/inline-samples.afdo -output=%t.proftext --drop-callsite-discriminators
RUN: FileCheck --input-file=%t.proftext %s   -check-prefixes=DROPDISC
RUN: llvm-profdata merge --sample --extbinary %S/Inputs/inline-samples.afdo -output=%t.profdata  --drop-callsite-discriminators
RUN: llvm-profdata merge --sample --text %t.profdata -output=%t.2.proftext
RUN: diff -b %t.2.proftext %t.proftext

